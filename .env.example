DATABASE_URL=postgresql+psycopg://fastsim:fastsim@localhost:5432/fastsim
JWT_SECRET=replace-with-a-long-random-value
CORS_ORIGINS=https://qulaysim.vercel.app,https://qulay-sim.vercel.app
PAYMENT_PROVIDER=disabled

# Keep this as mock until the refundable end-to-end provider test has passed.
ESIM_PROVIDER=mock
ESIMACCESS_BASE_URL=https://api.esimaccess.com
ESIMACCESS_ACCESS_CODE=
# Optional but recommended: enables the API's HMAC-SHA256 signed requests.
ESIMACCESS_SECRET_KEY=
# Create a long random value. Append it to the eSIM Access webhook URL:
# https://YOUR-API-DOMAIN/api/webhooks/esimaccess?token=VALUE
ESIMACCESS_WEBHOOK_TOKEN=

# Telegram support inbox — configure these only on the API host, never in the frontend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
