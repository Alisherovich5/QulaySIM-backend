# ---------------------------------------------------------------------------
# Required — the process refuses to start without these. There are no
# fall-back defaults for secrets, on purpose.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fastsim:fastsim@localhost:5432/fastsim
REDIS_URL=redis://localhost:6379/0
# For production add ?sslmode=require to DATABASE_URL unless Postgres is
# reached over a private network you control.

# Encrypts eSIM activation credentials at rest. Shared with the Django admin
# — the two services read the same columns. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=local          # local | staging | production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=https://qulaysim.vercel.app

# Tokens
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Rate limits — "requests/seconds"
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_SUPPORT=3/300

# Cache TTLs (seconds)
CACHE_TTL_CATALOG=300
CACHE_TTL_LANDING=300
CACHE_TTL_CURRENCY=21600

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=disabled
ESIM_PROVIDER=mock         # keep 'mock' until a refundable live test has passed
ESIMACCESS_BASE_URL=https://api.esimaccess.com
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SECRET_KEY=
# Append to the supplier webhook URL: .../api/webhooks/esimaccess?token=VALUE
ESIMACCESS_WEBHOOK_TOKEN=

# eSIMCard, the second wholesaler. NOT esimcard.com — that host answers every
# API path with HTTP 410; the API lives on portal.esimcard.com now.
# Token from https://partner.esimcard.com/reseller/api-keys/ (form: 1234567|…).
# No purchases are possible until the wallet is funded, whatever the token says.
ESIMCARD_BASE_URL=https://portal.esimcard.com/api/developer/reseller
ESIMCARD_API_TOKEN=

CBU_CURRENCY_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/
UZS_PER_USD_FALLBACK=12000

# Server-side only — never expose to the storefront.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# docker compose only — interpolated into the stack, not read by the API.
# Generate the Django key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,admin
DB_NAME=fastsim
DB_USER=fastsim
DB_PASSWORD=fastsim
API_PORT=8001
ADMIN_PORT=8002
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Payme (Paycom)
#
# PAYME_MERCHANT_KEY authenticates Payme's calls to us. PAYME_TEST_KEY is
# accepted alongside it so the same deployment can run Payme's sandbox suite
# without a second environment — leave it empty in production.
#
# PAYME_ACCOUNT_FIELD must match the field name configured in the merchant
# cabinet; Payme sends it inside the `account` object on every call.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=disabled     # set to 'payme' to accept payments
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_TEST_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_ACCOUNT_FIELD=order_id
PAYME_RETURN_URL=
